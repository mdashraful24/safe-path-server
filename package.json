{
	"name": "safe-path-server",
	"version": "1.0.0",
	"description": "Backend API for SafePath",
	"main": "index.js",
	"scripts": {
		"dev": "bun --watch src/server.ts",
		"build": "tsup",
		"start": "node dist/server.js",
		"postinstall": "prisma generate",
		"typecheck": "tsc --noEmit",
		"test": "echo \"Error: no test specified\" && exit 1",
		"db:generate": "bun --bun run prisma generate",
		"db:migrate": "bun --bun run prisma migrate dev",
		"db:studio": "bun --bun run prisma studio",
		"db:seed": "bun prisma/all-seeds/seed.ts",
		"format:check": "bunx @biomejs/biome format ./src",
		"format:fix": "bunx @biomejs/biome format --write ./src",
		"lint:check": "bunx @biomejs/biome lint ./src",
		"lint:fix": "bunx @biomejs/biome lint --write ./src"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "latest",
		"@types/compression": "^1.8.1",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.3.0",
		"@types/node": "^26.6.5",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.23.1",
		"prisma": "^7.10.1",
		"tsup": "^9.0.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "7",
		"bcryptjs": "^3.0.3",
		"cloudinary": "^2.11.0",
		"compression": "^1.8.2",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^18.0.8",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.1",
		"helmet": "^8.3.0",
		"http-status": "^2.1.0",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.5.0",
		"nodemailer": "^10.1.7",
		"pg": "^8.23.1",
		"redis": "^6.3.0",
		"zod": "^4.6.7"
	}
}
