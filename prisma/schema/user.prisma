model User {
  id String @id @default(uuid())

  name  String
  email String @unique

  passwordHash String

  imageUrl      String?
  imagePublicId String?

  role   Role       @default(USER)
  status UserStatus @default(ACTIVE)

  deletionRequestedAt     DateTime?
  deletionRequestReason   String?
  deletionRejectionReason String?
  deletionRejectedAt      DateTime?

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  tokenVersion Int @default(0)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]

  reportedIncidents Incident[]        @relation("ReportedIncidents")
  reviewedIncidents Incident[]        @relation("ReviewedIncidents")
  incidentChanges   IncidentHistory[] @relation("IncidentChanges")

  changeRequestsCreated  AdminChangeRequest[] @relation("ChangeRequestsCreated")
  changeRequestsTargeted AdminChangeRequest[] @relation("ChangeRequestsTargeted")
  changeRequestsReviewed AdminChangeRequest[] @relation("ChangeRequestsReviewed")

  @@index([role])
  @@index([status])
  @@index([deletionRequestedAt])
  @@map("users")
}
