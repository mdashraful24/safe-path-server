model Comment {
  id String @id @default(uuid())

  content String

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("IncidentComments", fields: [authorId], references: [id], onDelete: Cascade)

  editedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([incidentId, createdAt])
  @@index([authorId])
  @@map("comments")
}
